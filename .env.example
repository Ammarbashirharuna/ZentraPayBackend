# ============================================
# ZentraPay Backend — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================

# ----- Server -----
SERVER_PORT=8080
APP_ENV=dev
# Public base URL of THIS backend (used to build email + redirect links)
APP_BASE_URL=http://localhost:8080

# ----- Database (PostgreSQL) -----
# Full JDBC URL, e.g. jdbc:postgresql://localhost:5432/zentrapay_dev
DB_URL=jdbc:postgresql://localhost:5432/zentrapay_dev
DB_USERNAME=zentrapay_user
DB_PASSWORD=change_me

# ----- JWT -----
# Generate with: openssl rand -base64 64
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRATION=86400000

# ----- Email (Resend) -----
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@yourdomain.com

# ----- CashOnRails (payment provider) -----
CASHONRAILS_BASE_URL=https://mainapi.cashonrails.com/api/v1
# Server-side secret key (Bearer auth). Keep private.
CASHONRAILS_SECRET_KEY=
# Public key for client-side/inline SDK use.
CASHONRAILS_PUBLIC_KEY=
# Encryption key: HMAC-512 payout Signature header + webhook signature verification.
CASHONRAILS_ENCRYPTION_KEY=
# RSA private key (PKCS8 PEM) for the payout X-Signature (RSA-SHA256) header.
# Paste as a single line with \n between lines, or a base64 body.
CASHONRAILS_RSA_PRIVATE_KEY=
# Expected Bearer value on inbound webhook Authorization header.
CASHONRAILS_WEBHOOK_KEY=
# Name shown as the sender on payout transfers.
CASHONRAILS_SENDER_NAME=ZentraPay

# ----- Platform economics -----
# Fee retained on each successful payment, in basis points (100 = 1.00%).
PLATFORM_FEE_BASIS_POINTS=100

# ----- CORS -----
# Comma-separated list of allowed frontend origins
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Rate Limiting -----
# Public endpoints (auth): max requests per window per IP
RATE_LIMIT_PUBLIC_MAX=15
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
# General endpoints: max requests per window per IP
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60

# ----- Payment Reminders -----
# Hours before expiry to send reminder emails
REMINDER_HOURS_BEFORE_EXPIRY=24
# Hours of inactivity to trigger abandoned checkout email
REMINDER_ABANDONED_HOURS=2
